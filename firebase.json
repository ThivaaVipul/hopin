{
  "firestore": {
    "database": "(default)",
    "location": "asia-south1",
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "hosting": {
    "public": "firebase/hosting/public",
    "ignore": [
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/r/**",
        "destination": "/share.html"
      }
    ],
    "headers": [
      {
        "source": "/share.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/map/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=86400"
          }
        ]
      }
    ]
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Hopin",
        "supportEmail": "support@hopin-riders.firebaseapp.com"
      }
    }
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "hosting": {
      "port": 5005
    }
  }
}
