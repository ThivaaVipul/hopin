rules_version = '2';

// Who may read and write what. Only riders get in: accounts whose sign-in
// token carries the custom claim `rider: true`, set by the project owner
// outside the app (docs/ARCHITECTURE.md, Access). No account IDs or emails
// live here. Each collection opens in the milestone that needs it; anything
// not matched below stays closed. Every change starts with a failing test in
// test/.
service cloud.firestore {
  match /databases/{database}/documents {

    function isRider() {
      return request.auth != null && request.auth.token.rider == true;
    }

    function isSelf(uid) {
      return isRider() && request.auth.uid == uid;
    }

    function isString(value, minLength, maxLength) {
      return value is string && value.size() >= minLength && value.size() <= maxLength;
    }

    // A rider's profile. Both riders read it; only its owner writes it, and
    // never deletes it.
    match /people/{uid} {
      function validProfile() {
        let data = request.resource.data;
        return data.keys().hasOnly(['name', 'photoUrl', 'language', 'updatedAt'])
          && data.keys().hasAll(['name', 'language', 'updatedAt'])
          && isString(data.name, 1, 80)
          && (!('photoUrl' in data) || data.photoUrl == null || isString(data.photoUrl, 1, 2048))
          && data.language in ['en', 'ta']
          && data.updatedAt == request.time;
      }

      allow read: if isRider();
      allow create, update: if isSelf(uid) && validProfile();
      allow delete: if false;

      // Saved places: private to their owner. Removing one marks it with
      // deletedAt (so the other device hears of it); nothing is deleted.
      match /places/{placeId} {
        function optionalName(data, key) {
          return !(key in data) || data[key] == null || isString(data[key], 1, 200);
        }

        function validPlace() {
          let data = request.resource.data;
          let before = resource == null ? null : resource.data.get('deletedAt', null);
          return data.keys().hasOnly(['name', 'kind', 'lat', 'lng', 'placeEn', 'placeTa', 'placeSi', 'order', 'shareRides', 'updatedAt', 'deletedAt'])
            && data.keys().hasAll(['name', 'kind', 'lat', 'lng', 'updatedAt'])
            && isString(data.name, 1, 40)
            && data.kind in ['home', 'work', 'uni', 'other']
            && data.lat is number && data.lat >= -90 && data.lat <= 90
            && data.lng is number && data.lng >= -180 && data.lng <= 180
            && optionalName(data, 'placeEn')
            && optionalName(data, 'placeTa')
            && optionalName(data, 'placeSi')
            && (!('order' in data) || (data.order is int && data.order >= 0 && data.order <= 999))
            && (!('shareRides' in data) || data.shareRides is bool)
            && data.updatedAt == request.time
            && (!('deletedAt' in data) || data.deletedAt == null || data.deletedAt == request.time || data.deletedAt == before);
        }

        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validPlace();
        allow delete: if false;
      }

      // The rider's rides (docs/PLAN.md, Ride detection): private to their
      // owner, kept until removed (marked with deletedAt). A ride that was not
      // a bus comes without its path.
      match /rides/{rideId} {
        function optionalText(data, key, maxLength) {
          return !(key in data) || data[key] == null || isString(data[key], 1, maxLength);
        }

        function validRide() {
          let data = request.resource.data;
          let before = resource == null ? null : resource.data.get('deletedAt', null);
          return data.keys().hasOnly(['startedAt', 'endedAt', 'verdict', 'distanceM', 'path', 'halts', 'features', 'fromName', 'toName', 'guideTo', 'updatedAt', 'deletedAt'])
            && data.keys().hasAll(['startedAt', 'endedAt', 'verdict', 'distanceM', 'features', 'updatedAt'])
            && data.startedAt is timestamp
            && data.endedAt is timestamp
            && data.endedAt >= data.startedAt
            && data.verdict in ['bus', 'not_bus', 'unknown']
            && data.distanceM is number && data.distanceM >= 0 && data.distanceM <= 2000000
            && optionalText(data, 'path', 20000)
            && optionalText(data, 'halts', 10000)
            && data.features is map && data.features.size() <= 24
            && optionalText(data, 'fromName', 200)
            && optionalText(data, 'toName', 200)
            && optionalText(data, 'guideTo', 200)
            && data.updatedAt == request.time
            && (!('deletedAt' in data) || data.deletedAt == null || data.deletedAt == request.time || data.deletedAt == before);
        }

        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validRide();
        allow delete: if false;
      }

      // The rider's settings, one private document: the app's language and
      // the alert stages (docs/PLAN.md, Settings and updates).
      match /settings/{docId} {
        function validStage(stage) {
          return stage is map
            && stage.keys().hasOnly(['metres', 'pattern'])
            && stage.keys().hasAll(['metres', 'pattern'])
            && stage.metres in [3000, 2000, 1500, 1000, 700, 500, 400, 300, 150]
            && stage.pattern in ['gentleDoubleTap', 'strongLongBuzz', 'heartbeat', 'tripleKnock', 'rising', 'waves'];
        }

        function validSettings() {
          let data = request.resource.data;
          return data.keys().hasOnly(['language', 'stages', 'updatedAt'])
            && data.keys().hasAll(['language', 'stages', 'updatedAt'])
            && data.language in ['en', 'ta']
            && data.stages is list
            && data.stages.size() >= 1
            && data.stages.size() <= 3
            && validStage(data.stages[0])
            && (data.stages.size() < 2 || validStage(data.stages[1]))
            && (data.stages.size() < 3 || validStage(data.stages[2]))
            && data.updatedAt == request.time;
        }

        // The app listens to the whole (one-document) collection, which a
        // rule on the document's name would refuse; only `app` is writable.
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && docId == 'app' && validSettings();
        allow delete: if false;
      }
    }

    // A live share (docs/PLAN.md, Sharing and stops). Anyone holding a ride's
    // link reads its one document, so the id is long and unguessable; only
    // riders can look for open shares, and only the sharing rider writes. It
    // holds no name, and an ended share keeps no position and stays ended.
    match /shares/{shareId} {
      function optionalNumber(data, key, low, high) {
        return data[key] == null || (data[key] is number && data[key] >= low && data[key] <= high);
      }

      function optionalInt(data, key, low, high) {
        return data[key] == null || (data[key] is int && data[key] >= low && data[key] <= high);
      }

      function optionalText(data, key) {
        return data[key] == null || isString(data[key], 1, 200);
      }

      function validShare() {
        let data = request.resource.data;
        return data.keys().hasOnly(['uid', 'lat', 'lng', 'toName', 'toTa', 'toLat', 'toLng', 'leftMin', 'metresLeft', 'startedAt', 'endedAt', 'updatedAt'])
          && data.keys().hasAll(['uid', 'lat', 'lng', 'toName', 'toTa', 'toLat', 'toLng', 'leftMin', 'metresLeft', 'startedAt', 'endedAt', 'updatedAt'])
          && data.uid == request.auth.uid
          && optionalNumber(data, 'lat', -90, 90)
          && optionalNumber(data, 'lng', -180, 180)
          && optionalText(data, 'toName')
          && optionalText(data, 'toTa')
          && optionalNumber(data, 'toLat', -90, 90)
          && optionalNumber(data, 'toLng', -180, 180)
          && optionalInt(data, 'leftMin', 0, 1440)
          && optionalInt(data, 'metresLeft', 0, 2000000)
          && data.startedAt is timestamp
          && (data.endedAt == null || (data.endedAt is timestamp && data.lat == null && data.lng == null))
          && data.updatedAt == request.time;
      }

      allow get: if true;
      allow list: if isRider();
      allow create: if isRider()
        && shareId.matches('^[A-Za-z0-9]{20,40}$')
        && validShare()
        && request.resource.data.endedAt == null;
      allow update: if isRider()
        && resource.data.uid == request.auth.uid
        && resource.data.endedAt == null
        && request.resource.data.startedAt == resource.data.startedAt
        && validShare();
      allow delete: if isRider() && resource.data.uid == request.auth.uid;
    }

    // A bus ride's halts (docs/PLAN.md, Sharing and stops): pooled, so both
    // riders read them and each phone works out the stops; only the ride's
    // rider writes. Taken back by marking with deletedAt, never deleted.
    match /halts/{rideId} {
      function validHalts() {
        let data = request.resource.data;
        let before = resource == null ? null : resource.data.get('deletedAt', null);
        return data.keys().hasOnly(['uid', 'points', 'updatedAt', 'deletedAt'])
          && data.keys().hasAll(['uid', 'points', 'updatedAt'])
          && data.uid == request.auth.uid
          && isString(data.points, 0, 10000)
          && data.updatedAt == request.time
          && (!('deletedAt' in data) || data.deletedAt == null || data.deletedAt == request.time || data.deletedAt == before);
      }

      allow read: if isRider();
      allow create: if isRider() && rideId.matches('^[A-Za-z0-9]{8,40}$') && validHalts();
      allow update: if isRider() && resource.data.uid == request.auth.uid && validHalts();
      allow delete: if false;
    }

    // A rename or removal of a learned stop, kept at the stop's spot and
    // shared: either rider writes one; none is deleted.
    match /stopNotes/{noteId} {
      function validNote() {
        let data = request.resource.data;
        return data.keys().hasOnly(['lat', 'lng', 'name', 'removed', 'by', 'updatedAt'])
          && data.keys().hasAll(['lat', 'lng', 'removed', 'by', 'updatedAt'])
          && data.lat is number && data.lat >= -90 && data.lat <= 90
          && data.lng is number && data.lng >= -180 && data.lng <= 180
          && (!('name' in data) || data.name == null || isString(data.name, 1, 80))
          && data.removed is bool
          && data.by == request.auth.uid
          && data.updatedAt == request.time;
      }

      allow read: if isRider();
      allow create, update: if isRider() && validNote();
      allow delete: if false;
    }

    // A change to one direction of a route from the route files (docs/PLAN.md,
    // Which bus): its board lines (none keeps the file's) and whether it is
    // removed, shared by both riders; the newest note for a direction wins.
    // Either rider writes one; none is deleted.
    match /routeNotes/{noteId} {
      function optionalLine(data, key) {
        return !(key in data) || data[key] == null || isString(data[key], 1, 120);
      }

      function validRouteNote() {
        let data = request.resource.data;
        return data.keys().hasOnly(['route', 'direction', 'ta', 'si', 'en', 'removed', 'by', 'updatedAt'])
          && data.keys().hasAll(['route', 'direction', 'removed', 'by', 'updatedAt'])
          && isString(data.route, 1, 120)
          && isString(data.direction, 1, 200)
          && optionalLine(data, 'ta')
          && optionalLine(data, 'si')
          && optionalLine(data, 'en')
          && data.removed is bool
          && data.by == request.auth.uid
          && data.updatedAt == request.time;
      }

      allow read: if isRider();
      allow create, update: if isRider() && validRouteNote();
      allow delete: if false;
    }

    // A route the riders added by hand (docs/PLAN.md, Which bus): its number,
    // its two end towns, the towns along the way (as JSON text) and the road
    // OSRM drew (an encoded polyline). Shared: either rider adds, changes or
    // deletes one (marking it with deletedAt); none is deleted for real.
    match /routes/{routeId} {
      function optionalName(data, key) {
        return !(key in data) || data[key] == null || isString(data[key], 1, 120);
      }

      function isLat(value) {
        return value is number && value >= -90 && value <= 90;
      }

      function isLng(value) {
        return value is number && value >= -180 && value <= 180;
      }

      function validHandRoute() {
        let data = request.resource.data;
        let before = resource == null ? null : resource.data.get('deletedAt', null);
        return data.keys().hasOnly(['number', 'fromLat', 'fromLng', 'fromEn', 'fromTa', 'fromSi', 'toLat', 'toLng', 'toEn', 'toTa', 'toSi', 'via', 'road', 'by', 'updatedAt', 'deletedAt'])
          && data.keys().hasAll(['number', 'fromLat', 'fromLng', 'toLat', 'toLng', 'via', 'road', 'by', 'updatedAt'])
          && isString(data.number, 1, 12)
          && isLat(data.fromLat) && isLng(data.fromLng)
          && isLat(data.toLat) && isLng(data.toLng)
          && optionalName(data, 'fromEn')
          && optionalName(data, 'fromTa')
          && optionalName(data, 'fromSi')
          && optionalName(data, 'toEn')
          && optionalName(data, 'toTa')
          && optionalName(data, 'toSi')
          && isString(data.via, 0, 4000)
          && isString(data.road, 0, 20000)
          && data.by == request.auth.uid
          && data.updatedAt == request.time
          && (!('deletedAt' in data) || data.deletedAt == null || data.deletedAt == request.time || data.deletedAt == before);
      }

      allow read: if isRider();
      allow create: if isRider() && routeId.matches('^[A-Za-z0-9]{20}$') && validHandRoute();
      allow update: if isRider() && validHandRoute();
      allow delete: if false;
    }
  }
}
